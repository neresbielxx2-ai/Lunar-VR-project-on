# Agus VR sample — low-poly pyramid (OBJ, triangles + flat normals)
# Importe no AGUS MODEL LAB (.obj)
o AgusPyramid
v -0.7 -0.5 0.7
v 0.7 -0.5 0.7
v 0.7 -0.5 -0.7
v -0.7 -0.5 -0.7
v 0.0 0.9 0.0
vn 0.0 -1.0 0.0
vn 0.0 0.661 0.750
vn 0.750 0.661 0.0
vn 0.0 0.661 -0.750
vn -0.750 0.661 0.0
f 1//1 3//1 2//1
f 1//1 4//1 3//1
f 1//2 2//2 5//2
f 2//3 3//3 5//3
f 3//4 4//4 5//4
f 4//5 1//5 5//5
