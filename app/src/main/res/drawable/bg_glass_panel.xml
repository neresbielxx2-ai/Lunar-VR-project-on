<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <gradient android:angle="315" android:startColor="#F0101A30" android:centerColor="#E80A101F" android:endColor="#F0101A30"/>
            <stroke android:width="1.2dp" android:color="#407DE7FF"/>
        </shape>
    </item>
    <item android:top="1dp" android:left="6dp" android:right="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp"/>
            <gradient android:angle="90" android:startColor="#00FFFFFF" android:endColor="#14FFFFFF"/>
        </shape>
    </item>
</layer-list>
