<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <solid android:color="#334DE8FF"/>
            <stroke android:width="1dp" android:color="#804DE8FF"/>
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <solid android:color="#1F4DE8FF"/>
            <stroke android:width="1.4dp" android:color="#CC4DE8FF"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp"/>
            <solid android:color="#14182A4A"/>
            <stroke android:width="1dp" android:color="#3D5A7BB8"/>
        </shape>
    </item>
</selector>
